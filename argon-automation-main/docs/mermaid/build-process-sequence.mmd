config:
  sequence:
    diagramMarginX: 10
    diagramMarginY: 10
    actorMargin: 120
    width: 500
    height: 120
    boxMargin: 20
    messageMargin: 80
    noteMargin: 40
    noteAlign: "left"
    wrap: true
    wrapPadding: 20
    rightAngles: false
    showSequenceNumbers: false
    mirrorActors: false
  themeVariables:
    noteBkgColor: "#fffbf0"
    noteTextColor: "#333333"
